# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Public site URL: used for OAuth AND payment return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LOCAL DEV ONLY: preview /buyer and /seller without Supabase. Ignored in production builds.
# DEV_BYPASS_AUTH=true

# ───────────── PAYMENTS (server-only secrets: NEVER prefix with NEXT_PUBLIC_) ─────────────
# sandbox (default) | production. Anything but the exact word "production" = sandbox.
PAYMENT_ENV=sandbox

# eSewa. In sandbox you can leave both blank (public test values are used automatically).
# PRODUCTION: paste the product code + secret key from your eSewa merchant onboarding.
# ESEWA_PRODUCT_CODE=
# ESEWA_SECRET_KEY=

# Khalti. Required even in sandbox: register at https://test-admin.khalti.com for a test key.
# PRODUCTION: use the live secret key from https://admin.khalti.com
KHALTI_SECRET_KEY=

# DEV ONLY: skip the server-to-server status lookup (offline testing). Ignored in production builds.
# PAYMENT_MOCK_VERIFY=true
